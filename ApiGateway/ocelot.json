{
  "Routes": [
    {
      "DownstreamPathTemplate": "/company/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "company-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/company/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"
      },
      "RouteClaimsRequirement": {
        "permissions": "write:companies, read:companies, admin:all"
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/location/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "location-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/location/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"
      },
      "RouteClaimsRequirement": {
        "permissions": "write:location, read:location, admin:all"
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/orders/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "order-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/orders/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"
      },
      "RouteClaimsRequirement": {
        "permissions": "read:orders, write:orders, admin:all"
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/user/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "user-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/user/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"
      },
      "RouteClaimsRequirement": {
        "permissions": "read:users, write:users, admin:all"
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/employee/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "employee-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/employee/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"},
      "RouteClaimsRequirement": {
        "permissions": "read:employees, write:employees, admin:all"
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/routes/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "route-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/routes/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete", "Options"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0"
      },
      "RouteClaimsRequirement": {
        "permissions": ["read:routes", "write:routes", "write:location", "read:location", "admin:all"]
      },
      "AddHeadersToRequest": {
        "X-User-Id": "{claims.user_id}",
        "X-Company-Id": "{claims.company_id}"
      }
    },
    {
      "DownstreamPathTemplate": "/tracking/ws",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [{ "Host": "tracking-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/tracking/ws"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway"
  }
}
