      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Auth0",
        "AllowedScopes": ["read:companies", "write:companies"]
      }
    },
